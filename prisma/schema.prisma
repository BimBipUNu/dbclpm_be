// Khai báo generator và datasource
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  Admin
  Staff
  Customer
}

enum Status {
  Active
  Inactive
  Banned
}

enum ActiveStatus {
  Active
  Inactive
}

enum ProductType {
  Food
  Accessory
}

enum PaymentMethod {
  COD
  Banking
  Momo
  VNPay
  PayOS
}

enum OrderStatus {
  Pending
  Confirmed
  Packing
  Shipping
  Completed
  Cancelled
}

enum PaymentStatus {
  Pending
  Success
  Failed
  Refunded
}

enum ReviewStatus {
  Pending
  Approved
  Rejected
}

enum CouponStatus {
  Active
  Inactive
  Expired
}

enum BlogStatus {
  Draft
  Published
  Hidden
}

model User {
  user_id      Int       @id @default(autoincrement())
  full_name    String    @db.VarChar(150)
  email        String    @unique @db.VarChar(150)
  password     String    @db.VarChar(255)
  phone        String?   @db.VarChar(20)
  address      String?   @db.VarChar(255)
  avatar       String?   @db.VarChar(255)
  role         Role      @default(Customer)
  status       Status    @default(Active)
  created_at   DateTime? @default(now())
  updated_at   DateTime? @updatedAt

  cart         Cart?
  orders       Order[]   @relation("UserOrders")
  staff_orders Order[]   @relation("StaffOrders")
  reviews      Review[]
  wishlists    Wishlist[]
  activity_logs ActivityLog[]
  blogs        Blog[]    @relation("AuthorBlogs")

  @@map("Users")
}

// ---------------------------------------------------------
// 1. RECURSIVE CATEGORY
// ---------------------------------------------------------
model Category {
  category_id   Int          @id @default(autoincrement())
  category_name String       @db.VarChar(150)
  description   String?      @db.Text
  parent_id     Int?
  status        ActiveStatus @default(Active)
  created_at    DateTime?    @default(now())

  parent        Category?    @relation("SubCategories", fields: [parent_id], references: [category_id])
  children      Category[]   @relation("SubCategories")
  products      ProductCategory[]

  @@map("Categories")
}

model Brand {
  brand_id    Int          @id @default(autoincrement())
  brand_name  String       @db.VarChar(150)
  country     String?      @db.VarChar(100)
  description String?      @db.Text
  status      ActiveStatus @default(Active)

  products    Product[]

  @@map("Brands")
}

// ---------------------------------------------------------
// 2. MASTER-VARIANT PRODUCTS
// ---------------------------------------------------------
model Product {
  product_id     Int          @id @default(autoincrement())
  brand_id       Int
  product_name   String       @db.VarChar(255)
  description    String?      @db.Text
  thumbnail      String?      @db.VarChar(255)
  product_type   ProductType
  status         ActiveStatus @default(Active)
  created_at     DateTime?    @default(now())
  updated_at     DateTime?    @updatedAt

  brand          Brand        @relation(fields: [brand_id], references: [brand_id], onDelete: Restrict)
  categories     ProductCategory[]
  images         ProductImage[]
  options        ProductOption[]
  variants       ProductVariant[]
  reviews        Review[]
  wishlists      Wishlist[]
  seo            ProductSEO?

  @@map("Products")
}

model ProductCategory {
  product_id  Int
  category_id Int

  product     Product  @relation(fields: [product_id], references: [product_id], onDelete: Cascade)
  category    Category @relation(fields: [category_id], references: [category_id], onDelete: Cascade)

  @@id([product_id, category_id])
  @@map("ProductCategories")
}

model ProductImage {
  image_id   Int     @id @default(autoincrement())
  product_id Int
  image_url  String  @db.VarChar(255)

  product    Product @relation(fields: [product_id], references: [product_id], onDelete: Cascade)

  @@map("ProductImages")
}

model ProductOption {
  option_id   Int      @id @default(autoincrement())
  product_id  Int
  option_name String   @db.VarChar(100) // Ví dụ: "Màu sắc", "Kích cỡ"

  product     Product  @relation(fields: [product_id], references: [product_id], onDelete: Cascade)
  values      ProductOptionValue[]

  @@map("ProductOptions")
}

model ProductOptionValue {
  value_id    Int      @id @default(autoincrement())
  option_id   Int
  value       String   @db.VarChar(100) // Ví dụ: "Đỏ", "Size M"

  option      ProductOption  @relation(fields: [option_id], references: [option_id], onDelete: Cascade)
  variant_values VariantValue[]

  @@map("ProductOptionValues")
}

model ProductVariant {
  variant_id     Int       @id @default(autoincrement())
  product_id     Int
  sku            String    @unique @db.VarChar(100)
  price          Decimal   @db.Decimal(12, 2)
  stock_quantity Int       @default(0)
  allow_backorder Boolean  @default(false)
  image_url      String?   @db.VarChar(255)

  product        Product   @relation(fields: [product_id], references: [product_id], onDelete: Cascade)
  option_values  VariantValue[]
  cart_details   CartDetail[]
  order_details  OrderDetail[]
  reviews        Review[]

  @@map("ProductVariants")
}

model VariantValue {
  variant_id Int
  value_id   Int

  variant    ProductVariant     @relation(fields: [variant_id], references: [variant_id], onDelete: Cascade)
  value      ProductOptionValue @relation(fields: [value_id], references: [value_id], onDelete: Cascade)

  @@id([variant_id, value_id])
  @@map("VariantValues")
}

// ---------------------------------------------------------
// 3. CART & ORDER (Bây giờ liên kết với Variant)
// ---------------------------------------------------------
model Cart {
  cart_id    Int       @id @default(autoincrement())
  user_id    Int       @unique
  created_at DateTime? @default(now())

  user       User         @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  details    CartDetail[]

  @@map("Carts")
}

model CartDetail {
  cart_detail_id Int     @id @default(autoincrement())
  cart_id        Int
  variant_id     Int
  quantity       Int     @default(1)

  cart           Cart           @relation(fields: [cart_id], references: [cart_id], onDelete: Cascade)
  variant        ProductVariant @relation(fields: [variant_id], references: [variant_id], onDelete: Cascade)

  @@map("CartDetails")
}

model Order {
  order_id         Int           @id @default(autoincrement())
  user_id          Int
  staff_id         Int?
  order_date       DateTime?     @default(now())
  total_amount     Decimal       @default(0) @db.Decimal(12, 2)
  shipping_address String?       @db.VarChar(255)
  payment_method   PaymentMethod
  order_status     OrderStatus   @default(Pending)
  note             String?       @db.Text

  user             User          @relation("UserOrders", fields: [user_id], references: [user_id], onDelete: Restrict)
  staff            User?         @relation("StaffOrders", fields: [staff_id], references: [user_id], onDelete: SetNull)
  details          OrderDetail[]
  payments         Payment[]
  order_coupons    OrderCoupon[]

  @@map("Orders")
}

model OrderDetail {
  detail_id  Int     @id @default(autoincrement())
  order_id   Int
  variant_id Int
  quantity   Int     @default(1)
  unit_price Decimal @db.Decimal(12, 2)
  subtotal   Decimal @db.Decimal(12, 2)

  order      Order          @relation(fields: [order_id], references: [order_id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variant_id], references: [variant_id], onDelete: Restrict)

  @@map("OrderDetails")
}

model Payment {
  payment_id       Int           @id @default(autoincrement())
  order_id         Int
  payment_method   PaymentMethod
  payment_date     DateTime?     @default(now())
  amount           Decimal       @db.Decimal(12, 2)
  payment_status   PaymentStatus @default(Pending)
  transaction_code String?       @db.VarChar(100)

  order            Order         @relation(fields: [order_id], references: [order_id], onDelete: Cascade)

  @@map("Payments")
}

// ---------------------------------------------------------
// 4. OTHER ENTITIES (Wishlist, Review, Coupons...)
// Wishlist & Review trỏ tới Product Master thay vì Variant
// ---------------------------------------------------------
model Review {
  review_id   Int          @id @default(autoincrement())
  user_id     Int
  product_id  Int
  variant_id  Int?
  rating      Int          @db.TinyInt // Should be between 1 and 5
  comment     String?      @db.Text
  review_date DateTime?    @default(now())
  status      ReviewStatus @default(Pending)

  user        User         @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  product     Product      @relation(fields: [product_id], references: [product_id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variant_id], references: [variant_id], onDelete: SetNull)

  @@map("Reviews")
}

model Wishlist {
  wishlist_id Int       @id @default(autoincrement())
  user_id     Int
  product_id  Int
  created_at  DateTime? @default(now())

  user        User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  product     Product   @relation(fields: [product_id], references: [product_id], onDelete: Cascade)

  @@unique([user_id, product_id], name: "uq_wishlist_user_product")
  @@map("Wishlists")
}

model Coupon {
  coupon_id        Int          @id @default(autoincrement())
  coupon_code      String       @unique @db.VarChar(50)
  discount_percent Decimal      @db.Decimal(5, 2)
  start_date       DateTime
  end_date         DateTime
  quantity         Int          @default(0)
  status           CouponStatus @default(Active)

  order_coupons    OrderCoupon[]

  @@map("Coupons")
}

model OrderCoupon {
  id              Int     @id @default(autoincrement())
  order_id        Int
  coupon_id       Int
  discount_amount Decimal @default(0) @db.Decimal(12, 2)

  order           Order   @relation(fields: [order_id], references: [order_id], onDelete: Cascade)
  coupon          Coupon  @relation(fields: [coupon_id], references: [coupon_id], onDelete: Restrict)

  @@map("OrderCoupons")
}

model ActivityLog {
  log_id      Int       @id @default(autoincrement())
  user_id     Int
  action      String    @db.VarChar(255)
  description String?   @db.Text
  created_at  DateTime? @default(now())

  user        User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("ActivityLogs")
}

model BlogCategory {
  blog_category_id Int          @id @default(autoincrement())
  category_name    String       @db.VarChar(150)
  description      String?      @db.Text
  status           ActiveStatus @default(Active)
  created_at       DateTime?    @default(now())

  blogs            Blog[]

  @@map("BlogCategories")
}

model Blog {
  blog_id          Int          @id @default(autoincrement())
  blog_category_id Int
  author_id        Int
  title            String       @db.VarChar(255)
  slug             String       @unique @db.VarChar(255)
  thumbnail        String?      @db.VarChar(255)
  summary          String?      @db.Text
  content          String?      @db.LongText
  views            Int          @default(0)
  status           BlogStatus   @default(Draft)
  published_at     DateTime?
  created_at       DateTime?    @default(now())
  updated_at       DateTime?    @updatedAt

  category         BlogCategory @relation(fields: [blog_category_id], references: [blog_category_id], onDelete: Restrict)
  author           User         @relation("AuthorBlogs", fields: [author_id], references: [user_id], onDelete: Restrict)
  seo              BlogSEO?
  tags             BlogTagDetail[]

  @@map("Blogs")
}

model BlogTag {
  tag_id   Int             @id @default(autoincrement())
  tag_name String          @db.VarChar(100)
  slug     String          @unique @db.VarChar(100)

  blogs    BlogTagDetail[]

  @@map("BlogTags")
}

model BlogTagDetail {
  id      Int     @id @default(autoincrement())
  blog_id Int
  tag_id  Int

  blog    Blog    @relation(fields: [blog_id], references: [blog_id], onDelete: Cascade)
  tag     BlogTag @relation(fields: [tag_id], references: [tag_id], onDelete: Cascade)

  @@unique([blog_id, tag_id], name: "uq_blogtagdetails_blog_tag")
  @@map("BlogTagDetails")
}

model SEOSetting {
  seo_id           Int       @id @default(autoincrement())
  page_name        String    @db.VarChar(150)
  meta_title       String?   @db.VarChar(255)
  meta_description String?   @db.Text
  meta_keywords    String?   @db.VarChar(255)
  og_image         String?   @db.VarChar(255)
  canonical_url    String?   @db.VarChar(255)
  updated_at       DateTime? @updatedAt

  @@map("SEOSettings")
}

model ProductSEO {
  product_seo_id   Int     @id @default(autoincrement())
  product_id       Int     @unique
  meta_title       String? @db.VarChar(255)
  meta_description String? @db.Text
  meta_keywords    String? @db.VarChar(255)
  slug             String  @unique @db.VarChar(255)
  canonical_url    String? @db.VarChar(255)

  product          Product @relation(fields: [product_id], references: [product_id], onDelete: Cascade)

  @@map("ProductSEO")
}

model BlogSEO {
  blog_seo_id      Int     @id @default(autoincrement())
  blog_id          Int     @unique
  meta_title       String? @db.VarChar(255)
  meta_description String? @db.Text
  meta_keywords    String? @db.VarChar(255)
  canonical_url    String? @db.VarChar(255)

  blog             Blog    @relation(fields: [blog_id], references: [blog_id], onDelete: Cascade)

  @@map("BlogSEO")
}
